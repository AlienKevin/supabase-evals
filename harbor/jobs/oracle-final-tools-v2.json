{
  "job_name": "oracle-final-tools-v2",
  "jobs_dir": "targeted-parity-3x/oracle-final-tools-v2",
  "n_attempts": 1,
  "n_concurrent_trials": 25,
  "timeout_multiplier": 3.0,
  "retry": { "max_retries": 2 },
